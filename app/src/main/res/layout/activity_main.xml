<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mute"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/deleteBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_drop"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/deck"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/nextImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.45"
                android:background="@drawable/card_bg"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:scaleX="0.94"
                android:scaleY="0.94" />

            <FrameLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_bg"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/topImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/stampKeep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="24dp"
                    android:alpha="0"
                    android:background="@drawable/stamp_keep"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:rotation="-12"
                    android:text="@string/keep"
                    android:textColor="@color/keep"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stampDrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="24dp"
                    android:alpha="0"
                    android:background="@drawable/stamp_drop"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:rotation="12"
                    android:text="@string/drop"
                    android:textColor="@color/drop"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/doneView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/doneText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/doneDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/pill_drop"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/delete_now"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/doneReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/pill_outline"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/review_all"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/undoBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_small"
                android:gravity="center"
                android:text="@string/undo"
                android:textColor="@color/mute"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/noBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/circle_drop"
                android:gravity="center"
                android:text="@string/no"
                android:textColor="@color/drop"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yesBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/circle_keep"
                android:gravity="center"
                android:text="@string/yes"
                android:textColor="@color/keep"
                android:textSize="32sp"
                android:textStyle="bold" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/perm_text"
            android:textColor="@color/mute"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/permBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/pill_keep"
            android:gravity="center"
            android:minHeight="54dp"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="@string/perm_btn"
            android:textColor="#FF151515"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
